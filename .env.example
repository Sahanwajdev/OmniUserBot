# =====================================================================
# OmniUserBot Environment Configuration
# =====================================================================

# 1. Telegram API Credentials (Get these from https://my.telegram.org)
API_ID=12345678
API_HASH=your_telegram_api_hash_here

# 2. Telegram String Session (Run `python generate_session.py` to create one)
# If left blank, the bot will prompt for login in the terminal and create a local .session file.
STRING_SESSION=

# 3. Custom Command Prefix (default: .)
# You can set multiple prefixes, e.g. .!,
COMMAND_PREFIX=.

# 4. Sudo User IDs (Optional: space-separated Telegram user IDs allowed to run commands)
# Example: 123456789 987654321
SUDO_USERS=

# 5. Log Group/Channel ID (Optional: where bot events and errors are posted)
# Example: -1001234567890
LOG_CHAT_ID=

# 6. Bot Name & Customization
BOT_NAME=OmniUserBot
ALIVE_EMOJI=⚡
ALIVE_TEXT=OmniUserBot is running smooth and ultra-fast.

# 7. Assistant Bot for Interactive Inline Buttons (Created via @BotFather)
BOT_TOKEN=
BOT_USERNAME=
